<Window x:Class="PublicCloudDownloader.App.DownloadMonitorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Progress" Width="620" Height="390" MinWidth="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="Downloading…" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,10,0,0" Text="Preparing files" Foreground="{StaticResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="12" Margin="0,20,0,0" Minimum="0" Maximum="100" IsIndeterminate="True"/>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CurrentFileText" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock x:Name="CountText" Grid.Column="1" Margin="16,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"/></Grid>
        <ListBox x:Name="FailureList" Grid.Row="4" Margin="0,18,0,0" Visibility="Collapsed" BorderBrush="{StaticResource BorderBrush}"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="Retry_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Cancel_Click"/>
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
