<Window x:Class="PublicCloudDownloader.App.DownloadMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Progress" Width="620" Height="390" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" Text="Downloading…" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,10,0,0"
                   Text="Preparing files" Foreground="{StaticResource SecondaryTextBrush}"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="ProgressBar" Grid.Row="2" Height="12" Margin="0,20,0,0"
                     Minimum="0" Maximum="100" IsIndeterminate="True" />

        <Grid Grid.Row="3" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Activity log" FontWeight="SemiBold" />
            <TextBlock x:Name="CountText" Grid.Column="1" Margin="16,0,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <ListBox x:Name="ActivityList" Grid.Row="4"
                 BorderBrush="{StaticResource BorderBrush}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="Download activity log"
                 AutomationProperties.LiveSetting="Polite">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Failed">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Skipped">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="RetryButton" Style="{StaticResource SecondaryButton}"
                    AutomationProperties.Name="Retry"
                    Visibility="Collapsed" Click="Retry_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{StaticResource OcticonSync16}" Margin="0,0,7,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Style="{StaticResource Octicon16}" />
                    <TextBlock Text="Retry" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                    AutomationProperties.Name="Cancel"
                    Margin="10,0,0,0" Click="Cancel_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{StaticResource OcticonXCircle16}" Margin="0,0,7,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Style="{StaticResource Octicon16}" />
                    <TextBlock Text="Cancel" />
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Close"
                    Margin="10,0,0,0" Visibility="Collapsed" Click="Close_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{StaticResource OcticonX16}" Margin="0,0,7,0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Style="{StaticResource Octicon16}" />
                    <TextBlock Text="Close" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
