<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PublicCloudDownloader</AssemblyName>
    <RootNamespace>PublicCloudDownloader.App</RootNamespace>
    <Product>Public Cloud Downloader</Product>
    <ApplicationIcon>Assets\PublicCloudDownloader.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PublicCloudDownloader.Core\PublicCloudDownloader.Core.csproj" />
    <ProjectReference Include="..\PublicCloudDownloader.Infrastructure\PublicCloudDownloader.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PublicCloudDownloader.ico" />
  </ItemGroup>
</Project>
