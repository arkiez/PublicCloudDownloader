<Window x:Class="PublicCloudDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Public Cloud Downloader" Height="610" Width="840" MinHeight="570" MinWidth="720"
        WindowStartupLocation="CenterScreen" AutomationProperties.Name="Public Cloud Downloader">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="40,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="8" Background="#1E293B" VerticalAlignment="Center">
                    <Viewbox Margin="11"><Canvas Width="32" Height="32">
                        <Path Fill="#E0F2FE" Data="M8,24 C3.6,24 1,21.2 1,17.5 C1,14 3.5,11.2 6.9,10.8 C8.1,6.9 11.6,4 16,4 C21.2,4 25.4,7.9 26,13 C29,13.5 31,15.8 31,18.6 C31,21.7 28.5,24 25,24 Z"/>
                        <Path Stroke="#0369A1" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M16,13 L16,27 M11,22 L16,27 L21,22"/>
                    </Canvas></Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Public Cloud Downloader" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Download public Google Drive and OneDrive Personal files—no account required." Foreground="#CBD5E1" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="40,28,40,22">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="PUBLIC FOLDER OR FILE LINK" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceLinkBox" Text="{Binding SourceLink, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Public folder or file link" ToolTip="Paste a public Google Drive or OneDrive Personal link"/>
                        <Button Grid.Column="1" Content="Paste" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Paste_Click" AutomationProperties.Name="Paste link"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding LinkStatus}" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>

                    <TextBlock Grid.Row="4" Text="SAVE TO" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Local destination folder"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Browse_Click" AutomationProperties.Name="Browse destination"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="{Binding DestinationStatus}" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Anyone with the link" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="The app checks public access before creating files." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Download" Width="138" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanDownload}" Click="Download_Click" IsDefault="True" AutomationProperties.Name="Download"/>
                    </Grid>
                    <Border Grid.Row="9" Background="#F1F5F9" CornerRadius="5" Padding="12,9" Margin="0,20,0,0">
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Supported: "/><Run Text="Google Drive and OneDrive Personal public files and folders. OneDrive Business and SharePoint are not supported."/></TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="40,0,40,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="No sign-in • No sync • Files stay on this PC" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
            <TextBlock Grid.Column="1" Text="{Binding VersionText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
