<Window x:Class="PublicCloudDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Public Cloud Downloader"
        Width="720" Height="500" MinWidth="650" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Public Cloud Downloader">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource PrimaryBrush}"
                        VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{StaticResource SurfaceBrush}" StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  Data="M6.5,18.5 C3.5,18.5 1.5,16.5 1.5,13.8 C1.5,11.2 3.3,9.1 5.8,8.7 C6.7,5.8 9.3,3.7 12.5,3.7 C16.4,3.7 19.5,6.6 19.9,10.4 C22.1,10.8 23.8,12.7 23.8,15 C23.8,17 22.1,18.5 20,18.5" />
                            <Path Stroke="{StaticResource SurfaceBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12.5,10 L12.5,20 M9.2,16.7 L12.5,20 L15.8,16.7" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Public Cloud Downloader" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Download public Google Drive and OneDrive files - no sign-in required."
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,10" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PUBLIC FILE OR FOLDER LINK" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourceLinkBox" MinHeight="44"
                             Text="{Binding SourceLink, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Public folder or file link"
                             ToolTip="Paste a public Google Drive or OneDrive Personal link" />
                    <Button Grid.Column="1" Width="94" MinHeight="44" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Paste_Click"
                            AutomationProperties.Name="Paste link">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M5,1 L12,1 L14,3 L14,14 L5,14 Z M7,3 L7,0 L13,0 L15,2 L15,12 L13,12 L13,3 Z M7,5 L12,5 L12,6 L7,6 Z M7,8 L12,8 L12,9 L7,9 Z M7,11 L10,11 L10,12 L7,12 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Paste" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="2" MinHeight="17" Margin="0,4,0,0" Text="{Binding LinkStatus}"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />

                <TextBlock Grid.Row="4" Text="SAVE TO" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Grid Grid.Row="5" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox MinHeight="44" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Local destination folder" />
                    <Button Grid.Column="1" Width="94" MinHeight="44" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Browse_Click"
                            AutomationProperties.Name="Browse destination">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M1,3 L6.3,3 L8,5 L15,5 L15,14 L1,14 Z M2.5,6.5 L13.5,6.5 L13.5,12.5 L2.5,12.5 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Browse" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="6" MinHeight="17" Margin="0,4,0,0" Text="{Binding DestinationStatus}"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Public links only" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Access is checked before download." FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="142" MinHeight="44" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding CanDownload}" Click="Download_Click" IsDefault="True"
                            AutomationProperties.Name="Download">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M7.25,1 L8.75,1 L8.75,9.2 L11.5,6.45 L12.56,7.51 L8,12.07 L3.44,7.51 L4.5,6.45 L7.25,9.2 Z M2,13 L14,13 L14,15 L2,15 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Download" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="9" Margin="0,8,0,0" Padding="10,7" Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,8,0">
                            <Canvas Width="16" Height="16">
                                <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1"
                                         Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" />
                                <Path Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      Data="M8,7 L8,11 M8,4.5 L8,5" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Supports public Google Drive and OneDrive Personal files/folders. Business and SharePoint links aren't supported." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Created by Arkie'z K. Khositkhanawut" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
