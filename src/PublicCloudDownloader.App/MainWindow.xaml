<Window x:Class="PublicCloudDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Public Cloud Downloader"
        Width="900" Height="470" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/PublicCloudDownloader.ico"
        AutomationProperties.Name="Public Cloud Downloader">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="#FFFFFF"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <ContentControl Content="{StaticResource OcticonCloud24}"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Style="{StaticResource Octicon24}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Public Cloud Downloader" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Download public Google Drive and OneDrive files - no sign-in required."
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="24,10" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PUBLIC FILE OR FOLDER LINK" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SourceLinkBox" MinHeight="44" Padding="12,9,42,9"
                                 Text="{Binding SourceLink, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Public folder or file link"
                                 ToolTip="Paste a public Google Drive or OneDrive Personal link" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                Panel.ZIndex="1" Click="ClearSourceLink_Click"
                                ToolTip="Clear link" AutomationProperties.Name="Clear public link">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InputClearButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SourceLink}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl Content="{StaticResource OcticonX16}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Style="{StaticResource Octicon16}" />
                        </Button>
                    </Grid>
                    <Button Grid.Column="1" Width="94" MinHeight="44" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Paste_Click"
                            AutomationProperties.Name="Paste link">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentControl Content="{StaticResource OcticonPaste16}" Margin="0,0,7,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Style="{StaticResource Octicon16}" />
                            <TextBlock Text="Paste" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="2" MinHeight="17" Margin="0,4,0,0" Text="{Binding LinkStatus}"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />

                <TextBlock Grid.Row="4" Text="SAVE TO" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Grid Grid.Row="5" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="DestinationPathBox" MinHeight="44" Padding="12,9,42,9"
                                 Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Local destination folder" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                Panel.ZIndex="1" Click="ClearDestinationPath_Click"
                                ToolTip="Clear destination" AutomationProperties.Name="Clear destination folder">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InputClearButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DestinationPath}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl Content="{StaticResource OcticonX16}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Style="{StaticResource Octicon16}" />
                        </Button>
                    </Grid>
                    <Button Grid.Column="1" Width="94" MinHeight="44" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Browse_Click"
                            AutomationProperties.Name="Browse destination">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentControl Content="{StaticResource OcticonFileDirectory24}" Margin="0,0,7,0"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Style="{StaticResource Octicon16From24}" />
                            <TextBlock Text="Browse" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="6" MinHeight="17" Margin="0,4,0,0" Text="{Binding DestinationStatus}"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Public links only" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Access is checked before download." FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton x:Name="SupportedServicesToggle" Width="44" MinHeight="44" Margin="0,0,10,0" Padding="0"
                                Style="{StaticResource SecondaryToggleButton}"
                                ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="10000"
                                ToolTipService.ShowsToolTipOnKeyboardFocus="True"
                                AutomationProperties.Name="Supported services information"
                                AutomationProperties.HelpText="Supports public Google Drive and OneDrive Personal files/folders. Business and SharePoint links aren't supported.">
                            <ToggleButton.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource OcticonInfo16}" Margin="0,1,8,0"
                                                        Foreground="{StaticResource TextBrush}"
                                                        Style="{StaticResource Octicon16}" />
                                        <TextBlock Width="320" TextWrapping="Wrap"
                                                   Text="Supports public Google Drive and OneDrive Personal files/folders. Business and SharePoint links aren't supported." />
                                    </StackPanel>
                                </ToolTip>
                            </ToggleButton.ToolTip>
                            <ContentControl Content="{StaticResource OcticonInfo16}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                            Style="{StaticResource Octicon16}" />
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=SupportedServicesToggle}" Placement="Bottom"
                               IsOpen="{Binding IsChecked, ElementName=SupportedServicesToggle, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Width="360" Margin="0,6,0,0" Padding="12,10" CornerRadius="8"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Focusable="False">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Content="{StaticResource OcticonInfo16}" Margin="0,1,8,0"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    Style="{StaticResource Octicon16}" />
                                    <TextBlock Width="310" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                                               Focusable="False"
                                               Text="Supports public Google Drive and OneDrive Personal files/folders. Business and SharePoint links aren't supported." />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button MinWidth="142" MinHeight="44" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding CanDownload}" Click="Download_Click" IsDefault="True"
                                AutomationProperties.Name="Download">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ContentControl Content="{StaticResource OcticonDownload16}" Margin="0,0,7,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Style="{StaticResource Octicon16}" />
                                <TextBlock Text="Download" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Created by Arkie'z K. Khositkhanawut" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
